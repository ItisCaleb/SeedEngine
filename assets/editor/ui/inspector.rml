<template name="inspector">

    <head>
        <link type="text/rcss" href="widgets/widgets.rcss" />
    </head>

    <body>
        <div id="right-panel" class="panel" data-model="inspector">
            <div class="inspector-toolbar">
                <div class="panel-header compact">{{ inspector_title }}</div>
                <button class="small-button primary" data-event-click="save_inspector">Save</button>
            </div>
            <div class="status-text" data-if="has_status">{{ status }}</div>

            <div class="empty-text inspector-section" data-if="!inspector_available">
                Open a world from Assets.
            </div>

            <div data-for="section, section_index : inspector_sections" class="inspector-section">
                <div class="section-title" data-class-first-section="section_index == 0">
                    {{ section.title }}
                </div>

                <div class="button-row inspector-actions">
                    <div data-for="action, action_index : section.actions"
                        class="inspector-action-slot">
                        <button class="action" data-class-danger="action.danger"
                            data-event-click="invoke_inspector_action(section_index, action_index)">
                            {{ action.label }}
                        </button>
                    </div>
                </div>

                <div class="inspector-fields">
                    <div data-for="field, field_index : section.fields"
                        class="inspector-field-slot">
                        <x-inspector-field class="inspector-field"
                            data-attr-section="section_index" data-attr-field="field_index"
                            data-attr-revision="inspector_revision"
                            data-event-change="commit_inspector_field(section_index, field_index)">
                        </x-inspector-field>
                    </div>
                </div>
            </div>

            <div data-if="show_inspector_confirmation">
                <template src="popup">
                    <div class="seed-popup-title">{{ confirmation_title }}</div>
                    <div class="seed-popup-row">{{ confirmation_message }}</div>
                    <div class="seed-popup-actions">
                        <button class="seed-popup-button"
                            data-event-click="cancel_inspector_action">Cancel</button>
                        <button class="seed-popup-button danger-button"
                            data-event-click="confirm_inspector_action">Confirm</button>
                    </div>
                </template>
            </div>
        </div>
    </body>
</template>
