<template name="main-view">

    <head>
        <link type="text/rcss" href="widgets/widgets.rcss" />
    </head>

    <body>
        <div id="viewport-panel" class="panel" data-model="world_editor">
            <div class="viewport-toolbar">
                <div class="viewport-label">{{ editor_mode }}</div>
                <div class="toolbar-spacer"></div>
                <button class="small-button" id="camera-mode">Flycam</button>
                <button class="small-button" id="view-mode">Lit</button>
            </div>

            <div id="viewport" data-event-hover="viewport_pick"
                data-event-mousescroll="viewport_scroll">
                <img id="viewport-image" src="internal://main_view" />
                <div id="viewport-empty" data-if="show_viewport_empty">
                    <div class="viewport-message">{{ viewport_message }}</div>
                </div>
                <div id="pick-readout" data-if="editor_mode == 'Terrain'">
                    <span>World</span>
                    <span>{{ world_text }}</span>
                </div>
            </div>

            <div data-if="show_clear_tiles">
                <template src="popup">
                    <div class="seed-popup-title">Clear Terrain Tiles?</div>
                    <div class="seed-popup-row">This removes every terrain tile from the current world.</div>
                    <div class="seed-popup-actions">
                        <button class="seed-popup-button" data-event-click="cancel_clear_tiles">Cancel</button>
                        <button class="seed-popup-button" data-event-click="confirm_clear_tiles">Clear</button>
                    </div>
                </template>
            </div>
        </div>
    </body>
</template>
