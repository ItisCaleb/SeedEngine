<rml>

    <head>
        <title>Seed Editor</title>
        <link type="text/rcss" href="editor.rcss" />
        <link type="text/template" href="widgets/widgets.rml" />
        <link type="text/template" href="menu.rml" />
        <link type="text/template" href="asset_browser.rml" />
        <link type="text/template" href="main_view.rml" />
        <link type="text/template" href="inspector.rml" />
    </head>

    <body>
        <div id="main">
            <template src="main-menu"></template>
            <div id="workspace">
                <div id="left-panel" class="panel" data-model="world_editor">
                    <div class="panel-header">World</div>
                    <div class="status-text" data-if="has_status">{{ status }}</div>

                    <div class="button-row">
                        <button class="action primary" data-event-click="save_world">Save</button>
                        <button class="action" data-event-click="inspect_world">Inspect</button>
                    </div>

                    <div class="segmented">
                        <button class="segment" data-class-active="world_mode"
                            data-event-click="set_mode('world')">World</button>
                        <button class="segment" data-class-active="terrain_mode"
                            data-event-click="set_mode('terrain')">Terrain</button>
                    </div>

                    <div class="section-title">Terrain</div>
                    <div class="button-row">
                        <button class="action" data-event-click="add_terrain_tile">Add Tile</button>
                        <button class="action danger" data-event-click="request_clear_tiles">Clear</button>
                    </div>
                    <div class="metric-row"><span>Dirty</span><span class="metric-value">{{ dirty_maps }}</span></div>

                    <div data-if="terrain_mode">
                        <div class="section-title">Brush</div>
                        <div class="tool-grid">
                            <button class="tool" data-class-active="terrain_tool == 'Raise'"
                                data-event-click="set_tool('Raise')">Raise</button>
                            <button class="tool" data-class-active="terrain_tool == 'Lower'"
                                data-event-click="set_tool('Lower')">Lower</button>
                            <button class="tool" data-class-active="terrain_tool == 'Smooth'"
                                data-event-click="set_tool('Smooth')">Smooth</button>
                            <button class="tool" data-class-active="terrain_tool == 'Flatten'"
                                data-event-click="set_tool('Flatten')">Flatten</button>
                            <button class="tool" data-class-active="terrain_tool == 'Pick'"
                                data-event-click="set_tool('Pick')">Pick</button>
                            <button class="tool" data-class-active="terrain_tool == 'Splat'"
                                data-event-click="set_tool('Splat')">Splat</button>
                        </div>
                        <label>Radius {{brush_setting.radius}}</label>
                        <input class="range" type="range" min="0" max="50" step="1"
                            data-value="brush_setting.radius" />
                        <label>Strength {{brush_setting.strength}}</label>
                        <input class="range" type="range" min="0" max="50" step="1"
                            data-value="brush_setting.strength" />
                    </div>
                    <handle class="resize-x resize-right" size_target="left-panel"></handle>
                </div>

                <div id="center-panel">
                    <template src="main-view"></template>
                    <template src="asset-browser" id="asset-browser"></template>
                </div>

                <template src="inspector"></template>

                <div id="status-bar">
                    <span id="status-left">Ready</span>
                    <span id="status-right">60 FPS</span>
                </div>
            </div>
        </div>
    </body>
</rml>